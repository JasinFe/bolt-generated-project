{
  "description": "Rap / drill : 3 mots énormes, texte penché qui alterne, couleur différente à chaque phrase",
  "mode": "word",
  "words_per_screen": 3,
  "font": "Anton",
  "font_size": 132,
  "uppercase": true,
  "color_unsung": "#FFFFFF",
  "color_sung": "#FFFFFF",
  "palette": [
    "#FFE600",
    "#00E5FF",
    "#FF2D95",
    "#B6FF3B"
  ],
  "outline": 9,
  "outline_color": "#000000",
  "shadow": 7,
  "shadow_opacity": 0.8,
  "tilt": 4,
  "tilt_alternate": true,
  "position": "center",
  "lead_in": 0.08,
  "tail": 0.2,
  "hold_gap": 0.4,
  "active_scale": 1.14,
  "echo": {
    "scale": 0.72,
    "italic": true,
    "color": "#FF2D95"
  },
  "animation": {
    "in": "pop",
    "out": "none",
    "duration": 0.1
  }
}
