# Copiez ce fichier en « .env » (même dossier) et renseignez votre clé.
# Le fichier .env n'est jamais envoyé sur GitHub (il est dans .gitignore).

# Clé API.Bible (https://scripture.api.bible) — obligatoire pour les versions sous licence
API_BIBLE_KEY=

# Point de terminaison (valeur par défaut)
API_BIBLE_URL=https://rest.api.bible

# Langues à découvrir automatiquement (codes ISO 639-3, séparés par des virgules) : fra, eng, spa, por…
API_BIBLE_LANGS=fra

# Facultatif : liste explicite à la place de la découverte automatique
# API_BIBLE_VERSIONS=S21=<bibleId>|Segond 21|Bible Segond 21|fr

# Port du serveur
# PORT=3000

# Assistant IA (Claude, Anthropic) — facultatif : https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Ne pas ouvrir le navigateur automatiquement au démarrage
# MP_NO_OPEN=1
