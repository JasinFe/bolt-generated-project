# Site vitrine finakoperp.com : public et indexable.
#
# ATTENTION : ce fichier est dans public_html, donc AU-DESSUS de finakop-app/
# (le dossier web de la plateforme). Le serveur applique aussi les .htaccess
# des dossiers parents. Toutes les règles ci-dessous sont donc limitées à
# l'adresse principale (finakoperp.com / www) : la plateforme garde ses propres
# en-têtes (CSP, no-store, noindex) et ses réécritures.
Options -Indexes -MultiViews
ServerSignature Off
AddType video/mp4 .mp4
AddType image/webp .webp
SetEnvIfNoCase Host "^(www\.)?finakoperp\.com(:[0-9]+)?$" FK_VITRINE=1

<IfModule mod_rewrite.c>
    RewriteEngine On
    # www → domaine principal (une seule adresse pour les moteurs)
    RewriteCond %{HTTP_HOST} ^www\.(finakoperp\.com)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    # Fichiers cachés, sauvegardes et fichiers techniques : jamais servis
    RewriteCond %{HTTP_HOST} ^finakoperp\.com$ [NC]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
    RewriteCond %{HTTP_HOST} ^finakoperp\.com$ [NC]
    RewriteRule \.(bak|old|orig|sql|sqlite|db|log|zip|tar|gz|env|ini|sh|md|json|jsonl)$ - [F,L,NC]
    # Un seul script PHP autorisé sur la vitrine : le formulaire de contact
    RewriteCond %{HTTP_HOST} ^finakoperp\.com$ [NC]
    RewriteCond %{REQUEST_URI} !^/contact\.php$
    RewriteRule \.(php[0-9]?|phtml|phar)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff" env=FK_VITRINE
    Header always set X-Frame-Options "DENY" env=FK_VITRINE
    Header always set Referrer-Policy "strict-origin-when-cross-origin" env=FK_VITRINE
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" env=FK_VITRINE
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" env=FK_VITRINE
    Header always set Strict-Transport-Security "max-age=31536000" env=FK_VITRINE
    Header always unset X-Powered-By
    # Fichiers de assets/ : adresses à empreinte (?v=…, empreintes.py) — un
    # fichier modifié change d'adresse, il peut donc rester longtemps en cache.
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|mp4|ico)$">
        Header set Cache-Control "public, max-age=2592000" env=FK_VITRINE
    </FilesMatch>
    # Pages : toujours revalidées, pour qu'elles pointent vers les fichiers du jour.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache" env=FK_VITRINE
    </FilesMatch>
</IfModule>
