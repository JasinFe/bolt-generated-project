  {
    "key": "group_km_paiement",
    "title": "Paiement Artiste",
    "fields": [
      {
        "key": "field_km_pay_artiste_uid",
        "label": "Artiste (User ID)",
        "name": "artiste_user_id",
        "type": "number",
        "required": 1
      },
      {
        "key": "field_km_pay_date",
        "label": "Date de paiement",
        "name": "date_paiement",
        "type": "date_picker",
        "display_format": "d/m/Y",
        "return_format": "d/m/Y"
      },
      {
        "key": "field_km_pay_montant",
        "label": "Montant (€)",
        "name": "montant_paiement",
        "type": "number",
        "required": 1
      },
      {
        "key": "field_km_pay_methode",
        "label": "Méthode",
        "name": "methode_paiement",
        "type": "select",
        "choices": {
          "Virement": "Virement bancaire",
          "Mobile_Money": "Mobile Money",
          "Cash": "Cash",
          "PayPal": "PayPal",
          "Crypto": "Crypto"
        },
        "default_value": "Virement"
      },
      {
        "key": "field_km_pay_statut",
        "label": "Statut",
        "name": "statut_paiement",
        "type": "select",
        "choices": {
          "En attente": "En attente",
          "Payé": "Payé",
          "Annulé": "Annulé"
        },
        "default_value": "En attente"
      },
      {
        "key": "field_km_pay_reference",
        "label": "Référence / N° virement",
        "name": "reference_paiement",
        "type": "text"
      },
      {
        "key": "field_km_pay_pdf",
        "label": "Relevé PDF",
        "name": "releve_pdf",
        "type": "file",
        "return_format": "array",
        "mime_types": "pdf"
      },
      {
        "key": "field_km_pay_rapport_lie",
        "label": "Rapport lié (Post ID)",
        "name": "rapport_lie",
        "type": "number"
      },
      {
