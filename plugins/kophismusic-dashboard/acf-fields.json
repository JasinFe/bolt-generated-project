  {
    "key": "group_km_artiste_profile",
    "title": "Profil Artiste",
    "fields": [
      {
        "key": "field_km_art_user_id",
        "label": "Compte WordPress (User ID)",
        "name": "artiste_user_id",
        "type": "number",
        "instructions": "L'ID du compte utilisateur WordPress de l'artiste"
      },
      {
        "key": "field_km_art_tunecore_name",
        "label": "Nom sur TuneCore",
        "name": "tunecore_name",
        "type": "text",
        "instructions": "Doit correspondre exactement au nom dans les exports TuneCore"
      },
      {
        "key": "field_km_art_genre",
        "label": "Genre(s) musical(aux)",
        "name": "genre_musical",
        "type": "checkbox",
        "choices": {
          "Urban Gospel": "Urban Gospel",
          "Gospel": "Gospel",
          "Worship": "Worship",
          "R&B Gospel": "R&B Gospel",
          "Trap Gospel": "Trap Gospel",
          "Hip Hop / Rap": "Hip Hop / Rap",
          "Variété": "Variété",
          "Afro": "Afro",
          "Zouglou": "Zouglou",
          "Autre": "Autre"
        },
        "instructions": "Sélectionnez jusqu'à 3 genres. Maintenez Ctrl (ou Cmd sur Mac) pour plusieurs choix.",
        "layout": "horizontal",
        "toggle": 0,
        "return_format": "value"
      },
      {
        "key": "field_km_art_bio",
        "label": "Biographie courte",
        "name": "bio_artiste",
        "type": "textarea",
        "rows": 4
      },
      {
        "key": "field_km_art_spotify_url",
        "label": "Profil Spotify",
        "name": "spotify_url",
        "type": "url"
      },
      {
        "key": "field_km_art_apple_url",
        "label": "Profil Apple Music",
        "name": "apple_url",
        "type": "url"
      },
      {
        "key": "field_km_art_youtube_url",
        "label": "Chaîne YouTube",
        "name": "youtube_url",
        "type": "url"
      },
      {
        "key": "field_km_art_instagram_url",
        "label": "Instagram",
        "name": "instagram_url",
        "type": "url"
      },
      {
        "key": "field_km_art_commission",
        "label": "Commission Label (%)",
        "name": "commission_artiste",
        "type": "number",
        "instructions": "Pourcentage retenu par le LABEL pour cet artiste. Ex: 30 = le label prend 30%, l'artiste reçoit 70%. Laissez vide pour utiliser le taux global (Réglages → KM Dashboard).",
        "min": 0,
        "max": 100,
        "placeholder": "Ex: 30",
        "step": 0.5
      },
      {
        "key": "field_km_art_date_signature",
        "label": "Date de signature",
        "name": "date_signature",
        "type": "date_picker",
        "display_format": "d/m/Y",
        "return_format": "d/m/Y"
      },
      {
        "key": "field_km_art_statut",
        "label": "Statut contrat",
        "name": "statut_contrat",
        "type": "select",
        "choices": {
          "Actif": "Actif",
          "En négociation": "En négociation",
          "Expiré": "Expiré",
          "Suspendu": "Suspendu"
        },
        "default_value": "Actif"
      }
    ],
    "location": [
      [
        {
          "param": "post_type",
          "operator": "==",
          "value": "nos-artistes"
        }
      ]
    ],
    "position": "normal",
    "style": "default",
    "active": true
