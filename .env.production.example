# ---------------------------------------------------------------------------------
# Modèle de configuration pour Hostinger (Business Web Hosting).
# Copiez ce fichier sous le nom .env, puis remplacez les valeurs marquées « À REMPLIR ».
# APP_KEY et ENERGIE_CODE_PEPPER restent vides : « php artisan energie:installer » les génère.
# ---------------------------------------------------------------------------------

APP_NAME="EnerTrack"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# À REMPLIR : l'adresse de votre site, en https
APP_URL=https://votre-domaine.tld

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# À REMPLIR : hPanel → Bases de données → Gestion (les noms commencent par u123456789_)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_energie
DB_USERNAME=u000000000_energie
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# À REMPLIR : une boîte e-mail créée dans hPanel → E-mails (ex. contact@votre-domaine.tld)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contact@votre-domaine.tld
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@votre-domaine.tld"
MAIL_FROM_NAME="${APP_NAME}"

# EnerTrack
ENERGIE_CODE_PEPPER=
ENERGIE_FENETRE_MOYENNE=7
# database = alertes dans l'application ; ajoutez ,mail pour les recevoir aussi par e-mail
ENERGIE_CANAUX_ALERTES=database,mail
